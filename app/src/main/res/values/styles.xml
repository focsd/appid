<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppId builds against a framework resource set that does not expose
        Theme.Material.DayNight by name. The matching values-night resource
        below supplies the dark variant while this compatible parent preserves
        normal Android action-bar and dialog behavior on older devices.
    -->
    <style name="AppIdTheme" parent="android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAFAFC</item>
        <item name="android:textColorPrimary">#232328</item>
        <item name="android:textColorSecondary">#5C6069</item>
        <item name="android:textColorLink">#235F96</item>
        <item name="android:colorAccent">#2D4F96</item>
        <item name="android:statusBarColor">#172238</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#172238</item>
    </style>
</resources>
